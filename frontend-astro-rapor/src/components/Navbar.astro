---
// Navbar.astro
// Static shell — the #nav-container div is populated dynamically by client-side JS
---

<header id="main-header" class="bg-atlantis-900 shadow-lg z-20">
  <nav class="container mx-auto px-4">
    <div class="flex items-center justify-between w-full h-16">

      <!-- Logo + Dynamic Nav -->
      <div class="flex items-center h-full">
        <a href="#" class="text-xl font-bold text-white pr-4">Rapor SD</a>
        <div id="nav-container" class="flex items-center h-full" x-html="navHtml" @click.prevent="handleNavClick">
          <!-- Navigation is dynamically generated here by Alpine x-html -->
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center space-x-2 pl-4">
        <!-- Active Period Badge Button -->
        <button
          x-show="selectedPeriod"
          @click="showSemesterModal = true"
          type="button"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-atlantis-800 text-atlantis-100 hover:bg-atlantis-700 hover:text-white border border-atlantis-600/40 shadow-xs transition-all duration-200 cursor-pointer"
          title="Klik untuk mengganti periode / mode rapor"
        >
          <span 
            class="w-2 h-2 rounded-full flex-shrink-0"
            :class="{
              'bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.7)]': selectedPeriod?.type === 'btq',
              'bg-amber-400 shadow-[0_0_6px_rgba(251,191,36,0.7)]': selectedPeriod?.type === 'administrasi' || selectedPeriod?.semester === 0,
              'bg-sky-400 shadow-[0_0_6px_rgba(56,189,248,0.7)]': selectedPeriod?.type === 'semester'
            }"
          ></span>
          <span class="font-semibold" x-text="getPeriodBadgeText()"></span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-atlantis-300 ml-0.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </button>

        <a 
          href="/admin/logs"
          class="bg-atlantis-700 text-white p-2 rounded-md hover:bg-atlantis-600 transition-colors duration-200 flex items-center justify-center"
          title="Admin Logs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </a>

        <button
          @click="showSemesterModal = true"
          x-show="periodData.length > 1"
          class="bg-atlantis-700 text-white p-2 rounded-md hover:bg-atlantis-600 transition-colors duration-200 flex items-center justify-center"
          title="Ganti Periode"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </button>

        <button
          @click="refreshIframe"
          :disabled="!currentIframeUrl || isLoading"
          class="bg-atlantis-700 text-white p-2 rounded-md hover:bg-atlantis-600 disabled:bg-gray-500 disabled:cursor-not-allowed transition-colors duration-200"
          title="Refresh Frame"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h5m-5-2a9 9 0 112.55 12.08" />
          </svg>
        </button>

        <button
          @click="openNewTab"
          :disabled="!currentIframeUrl || isLoading"
          class="bg-atlantis-700 text-white p-2 rounded-md hover:bg-atlantis-600 disabled:bg-gray-500 disabled:cursor-not-allowed transition-colors duration-200"
          title="Open in New Tab"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </button>
      </div>

    </div>
  </nav>
</header>
